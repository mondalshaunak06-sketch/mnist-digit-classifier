{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Train Models (MLP & CNN)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--model", "all", "--epochs", "5", "--batch_size", "64"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Evaluate Models & Error Analysis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": ["--batch_size", "64"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
